# ─── n8n ────────────────────────────────────────────────────────────────────
# Your n8n instance URL (no trailing slash)
N8N_BASE_URL=https://your-instance.app.n8n.cloud

# n8n API key: n8n → Settings → n8n API → Create an API key
N8N_API_KEY=your_n8n_api_key_here

# ─── Groq ────────────────────────────────────────────────────────────────────
# Free key from https://console.groq.com → API Keys → Create API key
GROQ_API_KEY=gsk_your_groq_key_here

# ─── Atlassian (Confluence + Jira) ───────────────────────────────────────────
# Your Atlassian account email
ATLASSIAN_EMAIL=you@yourdomain.com

# API token from https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_API_TOKEN=your_atlassian_api_token_here

# Your Atlassian domain (no trailing slash)
ATLASSIAN_HOST=https://yourorg.atlassian.net

# ─── Workflow config ──────────────────────────────────────────────────────────
CONFLUENCE_SPACE_KEY=SD
JIRA_PROJECT_KEY=SCRUM
JIRA_BOARD_ID=1

# ─── Gmail ───────────────────────────────────────────────────────────────────
# Email address connected to Gmail OAuth2 (used only for display in setup output)
GMAIL_EMAIL=you@gmail.com
